# ============================================================
# LLMBench Environment Variables
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME=LLMBench
NEXT_PUBLIC_APP_VERSION=1.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://llmbench:secret@localhost:5432/llmbench
DATABASE_DIRECT_URL=postgresql://llmbench:secret@localhost:5432/llmbench

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ClickHouse (Analytics)
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=llmbench_analytics

# S3 / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=llmbench
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-super-secret-32-chars-min
JWT_SECRET=change-me-jwt-secret

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_AI_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Stripe (Billing)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
RESEND_API_KEY=re_...
SMTP_FROM=noreply@llmbench.ai

# Encryption
ENCRYPTION_KEY=32-byte-hex-encryption-key-here

# Feature Flags
ENABLE_SIGNUP=true
ENABLE_BILLING=false
ENABLE_RED_TEAM=true
ENABLE_RAG=true
